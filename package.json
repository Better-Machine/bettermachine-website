{
  "name": "bettermachine-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "echo 'see apps/* for build scripts'",
    "dev:public": "npm --workspace apps/public run dev",
    "dev:internal": "npm --workspace apps/internal run dev",
    "build:public": "npm --workspace apps/public run build",
    "build:internal": "npm --workspace apps/internal run build",
    "seed": "npm --workspace @bm/db run seed"
  },
  "engines": {
    "node": ">=20"
  }
}
